{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "globalEnv": [
    "GITHUB_ARGA_BASE_URL",
    "GITHUB_ARGA_TOKEN",
    "GITHUB_MODE",
    "GITHUB_OWNER",
    "GITHUB_READ_ISSUE_NUMBER",
    "GITHUB_REPO",
    "GITHUB_TOKEN",
    "GMAIL_ACCESS_TOKEN",
    "GMAIL_ARGA_BASE_URL",
    "GMAIL_ARGA_TOKEN",
    "GMAIL_MODE",
    "GMAIL_OAUTH_CLIENT_ID",
    "GMAIL_OAUTH_CLIENT_SECRET",
    "GMAIL_OAUTH_REFRESH_TOKEN",
    "GMAIL_PROVIDER_ACCOUNT_ID",
    "GMAIL_SENDER_ADDRESS",
    "GMAIL_SMOKE_TO",
    "GMAIL_THREAD_ID",
    "LEMMA_API_KEY",
    "LEMMA_PROJECT_ID",
    "LEMMA_RELEASE",
    "NODE_ENV",
    "OPENAI_API_KEY",
    "RECTIFY_API_ORIGIN",
    "RECTIFY_COMMIT",
    "RECTIFY_DB_PATH",
    "RECTIFY_EVAL_ARTIFACT_DIR",
    "RECTIFY_EVAL_OUTCOME_SECRET",
    "RECTIFY_EVAL_RESULTS_DIR",
    "RECTIFY_EVAL_TRIALS",
    "RECTIFY_INTAKE_DIRECTORY_JSON",
    "RECTIFY_MODEL_ID",
    "RECTIFY_OPERATOR_TOKEN",
    "RECTIFY_PRODUCT_EVENTS_URL",
    "RECTIFY_RELEASE_ID",
    "RECTIFY_WORKER_POLL_MS",
    "REPORTDESK_BASE_URL",
    "REPORTDESK_CUSTOMER_TOKEN",
    "REPORTDESK_ENVIRONMENT",
    "REPORTDESK_OPERATOR_ID",
    "REPORTDESK_OPERATOR_TOKEN",
    "REPORTDESK_OUTCOME_SECRET",
    "REPORTDESK_PORT",
    "REPORTDESK_PROBE_CREDENTIAL_ID",
    "REPORTDESK_PROBE_TOKEN",
    "REPORTDESK_PUBLIC_URL",
    "SLACK_APPROVER_IDS",
    "SLACK_ARGA_BASE_URL",
    "SLACK_ARGA_TOKEN",
    "SLACK_CHANNEL_ID",
    "SLACK_MODE",
    "SLACK_SIGNING_SECRET",
    "SLACK_TOKEN",
    "SLACK_WORKSPACE_ID"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
