{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "globalEnv": [
    "GITHUB_ARGA_BASE_URL",
    "GITHUB_ARGA_TOKEN",
    "GITHUB_MODE",
    "GITHUB_OWNER",
    "GITHUB_READ_ISSUE_NUMBER",
    "GITHUB_REPO",
    "GITHUB_TOKEN",
    "GMAIL_ACCESS_TOKEN",
    "GMAIL_ARGA_BASE_URL",
    "GMAIL_ARGA_TOKEN",
    "GMAIL_MODE",
    "GMAIL_SMOKE_TO",
    "GMAIL_THREAD_ID",
    "RECTIFY_DB_PATH",
    "RECTIFY_INTAKE_DIRECTORY_JSON",
    "RECTIFY_OPERATOR_TOKEN",
    "REPORTDESK_CUSTOMER_TOKEN",
    "REPORTDESK_ENVIRONMENT",
    "REPORTDESK_OPERATOR_ID",
    "REPORTDESK_OPERATOR_TOKEN",
    "REPORTDESK_OUTCOME_SECRET",
    "REPORTDESK_PORT",
    "REPORTDESK_PROBE_TOKEN",
    "SLACK_ARGA_BASE_URL",
    "SLACK_ARGA_TOKEN",
    "SLACK_APPROVER_IDS",
    "SLACK_CHANNEL_ID",
    "SLACK_MODE",
    "SLACK_SIGNING_SECRET",
    "SLACK_TOKEN"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
