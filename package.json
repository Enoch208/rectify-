{
  "name": "rectify",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "eval": "pnpm --filter @rectify/evals eval",
    "smoke:providers": "pnpm --filter @rectify/providers smoke",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:local": "sh -c 'set -a; . ./.env; set +a; turbo run dev'",
    "start:all": "node scripts/start-all.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "2.10.12"
  }
}
